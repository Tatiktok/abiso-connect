# =============================================
# ABISO CONNECT - Environment Variables
# Copy to .env.local for development
# Add all to Vercel Environment Variables
# =============================================

# Database (from Neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Facebook OAuth (App ID & Secret from developers.facebook.com)
FACEBOOK_CLIENT_ID="your_app_id"
FACEBOOK_CLIENT_SECRET="your_app_secret"

# Facebook Page (for reading SORECO II posts)
FB_PAGE_ID="61561274837850"
FB_PAGE_ACCESS_TOKEN="your_page_access_token"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_maps_key"

# Gmail SMTP
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your_gmail@gmail.com"
EMAIL_SERVER_PASSWORD="your_16char_app_password_no_spaces"
EMAIL_FROM="ABISO CONNECT <your_gmail@gmail.com>"

# Cron Security
CRON_SECRET="any_random_secret_string"

# Admin Account
ADMIN_EMAIL="your_admin_email@gmail.com"
ADMIN_PASSWORD="YourAdminPassword123!"

# Public (shown in navbar for admin check)
NEXT_PUBLIC_ADMIN_EMAIL="your_admin_email@gmail.com"

# Semaphore SMS - Philippine SMS Gateway (semaphore.co)
# Free trial available - works with Globe, Smart, DITO numbers
SEMAPHORE_API_KEY="your_semaphore_api_key"
SEMAPHORE_SENDER_NAME="ABISOCON"
